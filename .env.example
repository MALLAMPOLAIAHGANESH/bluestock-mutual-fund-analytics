# ============================================================
# Bluestock Mutual Fund — Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace each placeholder with your own local values
# 3. NEVER commit .env to Git
# 4. Keep .env.example safe and version-controlled
# ============================================================

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bluestock_mf
DB_USER=postgres
DB_PASSWORD=change-me

# Optional: pgAdmin connection
PGADMIN_EMAIL=your_email@example.com
PGADMIN_PASSWORD=change-me
